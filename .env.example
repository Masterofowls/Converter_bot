# Telegram Bot Configuration (copy this to .env and fill in values)
BOT_TOKEN=your_bot_token_here

# Logging
LOG_LEVEL=INFO

# Performance Settings
MAX_CONCURRENT_CONVERSIONS=3

# External APIs (Optional - for extended format support)
CLOUDCONVERT_ENABLED=false
CLOUDCONVERT_API_KEY=your_key_here

ZAMZAR_ENABLED=false
ZAMZAR_API_KEY=your_key_here
